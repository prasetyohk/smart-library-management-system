# ==============================================================================
# PERPUSTAKAAN KB-TK BHAKTI TUNAS HARAPAN (SBTH) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# File ini adalah contoh konfigurasi keamanan server.
# Salin file ini menjadi `.env.local` pada server/komputer Anda:
#   copy .env.example .env.local
#
# JANGAN PERNAH mengunggah file `.env.local` berisi token rahasia ke GitHub publik!
# ==============================================================================

# 1. SERVER AUTHENTICATION SECRET
# Kunci rahasia untuk menandatangani JWT / HttpOnly Session Cookie pustakawan
# Buat string acak minimal 32 karakter
SESSION_SECRET=sbth-library-production-secure-auth-secret-key-2026-bth-magelang

# 2. TELEGRAM BOT NOTIFICATION & BACKUP (SERVER-SIDE)
# Dapatkan Bot Token dari @BotFather di Telegram
# Dapatkan Chat ID grup/kanal dari @userinfobot atau @getidsbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. ENVIRONMENT & PERSISTENCE MODE
# Pilihan: 'local' (SQLite di PC lokal) atau 'production'
NEXT_PUBLIC_APP_ENV=local

# 4. DATABASE PATH (OPSIONAL - DEFAULT: data/sbth_library.db)
SQLITE_DB_PATH=data/sbth_library.db

# 5. ONLINE CLOUD DATABASE (OPSIONAL - JIKA MIGRASI KE SUPABASE / POSTGRESQL)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
